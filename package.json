{
  "name": "warungai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered conversational POS and Smart CRM inside WhatsApp for Indonesian warung.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" server.js eslint.config.js vitest.config.js package.json .prettierrc",
    "db:start": "mkdir -p ./.local/mongo && ${MONGOD:-mongod} --dbpath ./.local/mongo --port 27017 --bind_ip 127.0.0.1 --replSet rs0",
    "db:init": "node scripts/init-replset.mjs",
    "db:inspect": "node scripts/inspect-db.mjs",
    "check:stt": "node scripts/check-stt.mjs",
    "db:reset": "rm -rf ./.local/mongo/* && echo 'Local DB wiped (restart db:start, then db:init).'",
    "sim": "node scripts/simulate-webhook.mjs"
  },
  "dependencies": {
    "@google-cloud/speech": "7.3.1",
    "@google/genai": "2.7.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "mongoose": "9.6.3",
    "node-cron": "4.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "vitest": "4.1.7"
  }
}
