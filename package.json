{
  "name": "warungai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered conversational POS and Smart CRM inside WhatsApp for Indonesian warung.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" server.js eslint.config.js vitest.config.js package.json .prettierrc"
  },
  "dependencies": {
    "@google-cloud/speech": "7.3.1",
    "@google/genai": "2.7.0",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "mongoose": "9.6.3",
    "node-cron": "4.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "vitest": "4.1.7"
  }
}
