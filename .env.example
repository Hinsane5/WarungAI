# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=https://<your-ngrok-or-domain>

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/warungai

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Google Cloud (AI) ---
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Feature flags / limits (tier gating) ---
FREE_TIER_DAILY_TXN_CAP=50
KOIN_BOT_ENABLED=true
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
