# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=https://<your-ngrok-or-domain>

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/warungai

# --- WhatsApp transport ---
# cloud = Meta Cloud API (below) | n8n = via n8n + gateway (see DOCS/N8N_INTEGRATION.md)
WHATSAPP_PROVIDER=cloud

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- n8n transport (required only when WHATSAPP_PROVIDER=n8n) ---
N8N_OUTBOUND_URL=
N8N_OUTBOUND_SECRET=
N8N_INBOUND_SECRET=
N8N_SEND_DELAY_MS=0

# --- Google Cloud (AI) ---
# Optional. Leave empty to use ADC (`gcloud auth application-default login`).
# Set to a service-account key path only when using key-file auth.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Feature flags / limits (tier gating) ---
FREE_TIER_DAILY_TXN_CAP=50
KOIN_BOT_ENABLED=true
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
SESSION_TTL_MINUTES=60
STT_LOW_CONFIDENCE_THRESHOLD=0.75
KASBON_DEFAULT_DUE_DAYS=14
KASBON_WATCH_RISK_THRESHOLD=1
KASBON_RISKY_RISK_THRESHOLD=1000000

# --- CRM / batch jobs (Phase 7) ---
SALES_WINDOW_DAYS=14
RESTOCK_LEAD_TIME_DAYS=3
EXPIRY_WARN_DAYS=7
CRM_JOBS_ENABLED=true
CRM_NIGHTLY_CRON=0 1 * * *
CRM_TIMEZONE=Asia/Jakarta
